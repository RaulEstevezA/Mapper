{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User",
  "type": "object",
  "properties": {
    "userId": {
      "type": "number"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "emailAddress": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "isActive": {
      "type": "boolean"
    }
  },
  "required": [
    "userId",
    "firstName",
    "lastName",
    "emailAddress",
    "createdAt",
    "isActive"
  ]
}
