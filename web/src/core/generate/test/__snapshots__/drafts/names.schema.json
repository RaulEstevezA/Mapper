{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customer",
  "type": "object",
  "properties": {
    "customerId": {
      "type": "integer"
    },
    "givenName": {
      "type": "string"
    },
    "surname": {
      "type": "string"
    },
    "mail": {
      "type": "string"
    },
    "dob": {
      "type": "string",
      "format": "date"
    },
    "tel": {
      "type": "string"
    },
    "qtyOrders": {
      "type": "integer"
    },
    "creationDate": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "customerId",
    "givenName",
    "surname",
    "mail",
    "dob",
    "tel",
    "qtyOrders",
    "creationDate"
  ]
}
