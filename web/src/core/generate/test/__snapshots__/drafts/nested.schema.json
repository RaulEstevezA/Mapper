{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order",
  "type": "object",
  "properties": {
    "id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "customer": {
      "$ref": "#/$defs/Customer"
    },
    "shipping": {
      "$ref": "#/$defs/Address"
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "customer",
    "shipping",
    "status"
  ],
  "$defs": {
    "Customer": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "email"
      ]
    },
    "Address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "zipCode": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      },
      "required": [
        "street",
        "city",
        "zipCode",
        "country"
      ]
    }
  }
}
